# Copy to docker/.env before running: cp docker/.env.example docker/.env

MYSQL_ROOT_PASSWORD=root-secret
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=wordpress-secret

# Host ports
HTTP_PORT=8080
VARNISH_PORT=6081

# Shared Varnish purge key. Keep in sync with tests/e2e/varnish.vcl.
ICC_GG_VARNISH_KEY=dev-purge-key
