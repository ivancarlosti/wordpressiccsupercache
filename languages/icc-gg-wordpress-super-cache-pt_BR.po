#, php-format
msgid "Newest entry %1$s ago, oldest entry %2$s ago."
msgstr "Entrada mais recente há %1$s, entrada mais antiga há %2$s."

#: includes/ui/tabs/local.php:242
msgid "No cached pages yet."
msgstr "Nenhuma página em cache ainda."

#: includes/ui/tabs/local.php:247
msgid "The cache directory is not writable, so pages cannot be cached."
msgstr "O diretório de cache não é gravável, portanto as páginas não podem ser armazenadas em cache."

#. translators: %d = Number of URLs waiting to be preloaded.
#: includes/ui/tabs/local.php:257
#, php-format
msgid "%d URL is waiting to be preloaded."
msgid_plural "%d URLs are waiting to be preloaded."
msgstr[0] "O URL %d está aguardando para ser pré-carregado."
msgstr[1] "Os URLs %d estão aguardando para serem pré-carregados."

#: includes/ui/tabs/local.php:271
msgid "Clear the cache when posts, comments, menus or themes change"
msgstr "Limpe o cache quando postagens, comentários, menus ou temas mudarem"

#: includes/ui/tabs/local.php:272
msgid "Store a gzipped copy of each page"
msgstr "Armazene uma cópia compactada de cada página"

#: includes/ui/tabs/local.php:273
msgid "Also cache URLs with query strings"
msgstr "Armazene também URLs em cache com strings de consulta"

#: includes/ui/tabs/local.php:274
msgid "Keep separate copies for mobile devices"
msgstr "Mantenha cópias separadas para dispositivos móveis"

#: includes/ui/tabs/local.php:275
msgid "Send browser caching headers with cached pages"
msgstr "Envie cabeçalhos de cache do navegador com páginas em cache"

#: includes/ui/tabs/local.php:276
msgid "Add an X-ICC-Page-Cache header to cached responses"
msgstr "Adicione um cabeçalho X-ICC-Page-Cache às respostas armazenadas em cache"

#: includes/ui/tabs/local.php:277
msgid "Preload the cache automatically after it is cleared"
msgstr "Pré-carregar o cache automaticamente depois de limpo"

#: includes/ui/tabs/local.php:301
msgid "Cache pages with the local PHP page cache"
msgstr "Armazenar páginas em cache com o cache de página PHP local"

#: includes/ui/tabs/local.php:305
msgid "Only one page cache backend can be enabled at a time: enabling this one requires disabling the Varnish Cache and nginx FastCGI page caches first."
msgstr "Apenas um back-end de cache de página pode ser ativado por vez: habilitá-lo requer desabilitar primeiro os caches de página Varnish Cache e nginx FastCGI."

#: includes/ui/tabs/local.php:310
msgid "Overridden by the ICC_GG_SUPER_CACHE_LOCAL_ENABLED constant in wp-config.php."
msgstr "Substituído pela constante ICC_GG_SUPER_CACHE_LOCAL_ENABLED em wp-config.php."

#: includes/ui/tabs/local.php:319
msgid "Cache Expiry"
msgstr "Expiração do Cache"

#: includes/ui/tabs/local.php:335
msgid "Cached pages older than this are regenerated on the next visit. Content changes always clear the cache immediately."
msgstr "As páginas armazenadas em cache mais antigas serão regeneradas na próxima visita. As alterações de conteúdo sempre limpam o cache imediatamente."

#: includes/ui/tabs/local.php:358
msgid "(zlib is not available on this server)"
msgstr "(zlib não está disponível neste servidor)"

#: includes/ui/tabs/local.php:369
msgid "Preload Batch Size"
msgstr "Tamanho do lote pré-carregado"

#: includes/ui/tabs/local.php:384
msgid "Number of URLs requested per preload batch. Lower values are gentler on small servers."
msgstr "Número de URLs solicitados por lote de pré-carregamento. Valores mais baixos são mais suaves em servidores pequenos."

#: includes/ui/tabs/local.php:391
msgid "Exclusions"
msgstr "Exclusões"

#: includes/ui/tabs/local.php:398
msgid "URLs"
msgstr "URLs"

#: includes/ui/tabs/local.php:410
msgid "One path or URL per line, for example /cart/ or /my-account/*. Wildcards are supported, and a line can start with regex: to use a regular expression."
msgstr "Um caminho ou URL por linha, por exemplo /carrinho/ ou /minha-conta/*. Curingas são suportados e uma linha pode começar com regex: para usar uma expressão regular."

#: includes/ui/tabs/local.php:414
msgid "The plugin already fills in the WordPress paths that should never be cached. The engine also skips /wp-admin, wp-login.php, wp-json, wp-cron.php, xmlrpc.php, feeds and trackbacks even when they are missing from this list."
msgstr "O plugin já preenche os caminhos do WordPress que nunca devem ser armazenados em cache. O mecanismo também ignora /wp-admin, wp-login.php, wp-json, wp-cron.php, xmlrpc.php, feeds e trackbacks mesmo quando estão ausentes nesta lista."

#: includes/ui/tabs/local.php:418
msgid "These exclusions only apply to this local page cache. Varnish Cache and nginx FastCGI answer before WordPress runs, so they need the same paths in their own configuration; the snippets on their tabs are generated from this list."
msgstr "Essas exclusões se aplicam apenas a esse cache de página local. O Varnish Cache e o nginx FastCGI respondem antes da execução do WordPress, portanto, eles precisam dos mesmos caminhos em sua própria configuração; os trechos em suas guias são gerados a partir desta lista."

#: includes/ui/tabs/local.php:423
msgid "Restore default exclusions"
msgstr "Restaurar exclusões padrão"

#: includes/ui/tabs/local.php:428
msgid "Restoring the defaults replaces the current list, including your own entries. Save the form first if you want to keep a copy."
msgstr "A restauração dos padrões substitui a lista atual, incluindo suas próprias entradas. Salve o formulário primeiro se quiser manter uma cópia."

#: includes/ui/tabs/local.php:436
msgid "User Agents"
msgstr "Agentes de usuário"

#: includes/ui/tabs/local.php:448
msgid "One user agent fragment per line, for example Googlebot or bot. Matching requests are never cached."
msgstr "Um fragmento de agente de usuário por linha, por exemplo, Googlebot ou bot. As solicitações correspondentes nunca são armazenadas em cache."

#: includes/ui/tabs/local.php:456
msgid "Cookies"
msgstr "Biscoitos"

#: includes/ui/tabs/local.php:468
msgid "One cookie name per line. Requests carrying these cookies are never cached. Logged-in users, commenters and password protected posts are always excluded."
msgstr "Um nome de cookie por linha. As solicitações que transportam esses cookies nunca são armazenadas em cache. Usuários logados, comentaristas e postagens protegidas por senha são sempre excluídos."

#: includes/ui/tabs/local.php:476
msgid "Save Page Cache Settings"
msgstr "Salvar configurações de cache de página"

#: includes/ui/tabs/local.php:484
msgid "Clear & Preload"
msgstr "Limpar e pré-carregar"

#: includes/ui/tabs/local.php:491
msgid "Clear Cache"
msgstr "Limpar Cache"

#: includes/ui/tabs/local.php:494
msgid "Clear everything at once, or purge only the pages that changed. Purging a URL also removes its gzipped copy and any empty directory left behind."
msgstr "Limpe tudo de uma vez ou limpe apenas as páginas que foram alteradas. A limpeza de um URL também remove sua cópia compactada e qualquer diretório vazio deixado para trás."

#: includes/ui/tabs/local.php:505 includes/ui/tabs/local.php:526
msgid "Purge URLs"
msgstr "Limpar URLs"

#: includes/ui/tabs/local.php:518
msgid "One URL or path per line. Use a trailing * to purge everything below a path."
msgstr "Um URL ou caminho por linha. Use um * à direita para limpar tudo abaixo de um caminho."

#: includes/ui/tabs/local.php:531
msgid "Maintenance"
msgstr "Manutenção"

#: includes/ui/tabs/local.php:535
msgid "Regenerate Page Cache Loader"
msgstr "Regenerar carregador de cache de página"

#: includes/ui/tabs/local.php:539
msgid "Write / Rewrite advanced-cache.php"
msgstr "Escrever/Reescrever advanced-cache.php"

#: includes/ui/tabs/local.php:544
msgid "Revert wp-config.php Backup"
msgstr "Reverter backup wp-config.php"

#: includes/ui/tabs/local.php:550
msgid "\"Regenerate Page Cache Loader\" refreshes the engine files and rewrites the loader only when it already belongs to this plugin."
msgstr "\"Regenerate Page Cache Loader\" atualiza os arquivos do mecanismo e reescreve o carregador somente quando ele já pertence a este plugin."

#: includes/ui/tabs/local.php:554
msgid "\"Write / Rewrite advanced-cache.php\" writes the loader even when the file is missing, damaged, outdated or owned by another plugin. The current file is copied to advanced-cache.icc-gg-backup.php before it is replaced."
msgstr "\"Write / Rewrite advanced-cache.php\" grava o carregador mesmo quando o arquivo está ausente, danificado, desatualizado ou de propriedade de outro plugin. O arquivo atual é copiado para advanced-cache.icc-gg-backup.php antes de ser substituído."

#: includes/ui/tabs/local.php:558
msgid "When WP_CACHE cannot be added to wp-config.php, both buttons write the must-use plugin loader (wp-content/mu-plugins/icc-gg-page-cache.php) instead."
msgstr "Quando WP_CACHE não pode ser adicionado a wp-config.php, ambos os botões gravam o carregador de plug-in obrigatório (wp-content/mu-plugins/icc-gg-page-cache.php)."

#: includes/ui/tabs/local.php:562
msgid "The same values can be defined in wp-config.php with the ICC_GG_SUPER_CACHE_LOCAL_ENABLED, ICC_GG_SUPER_CACHE_LOCAL_AUTO_PURGE and ICC_GG_SUPER_CACHE_LOCAL_PATH constants."
msgstr "Os mesmos valores podem ser definidos em wp-config.php com as constantes ICC_GG_SUPER_CACHE_LOCAL_ENABLED, ICC_GG_SUPER_CACHE_LOCAL_AUTO_PURGE e ICC_GG_SUPER_CACHE_LOCAL_PATH."

