msgstr "Os mesmos valores podem ser definidos em wp-config.php com as constantes ICC_GG_SUPER_CACHE_VARNISH_ENABLED, ICC_GG_SUPER_CACHE_VARNISH_HOST, ICC_GG_SUPER_CACHE_VARNISH_PORT, ICC_GG_SUPER_CACHE_VARNISH_KEY e ICC_GG_SUPER_CACHE_VARNISH_AUTO_PURGE."

#. translators: 1: plugin name, 2: required PHP version, 3: current PHP version.
#: icc-gg-wordpress-super-cache.php:99
#, php-format
msgid "%1$s requires PHP %2$s or later. This site runs PHP %3$s, so the plugin has been deactivated."
msgstr "%1$s requer PHP %2$s ou posterior. Este site roda PHP %3$s, então o plugin foi desativado."

